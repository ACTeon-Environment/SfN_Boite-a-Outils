{
  "impacts": [
    {
      "id": 1,
      "name": "Coûts de mise en œuvre de la SfN",
      "description": "Coûts d'investissement, de gestion/d'exploitation et de maintenance"
    },
    {
      "id": 2,
      "name": "Pertes d'activités économiques",
      "description": "Pertes de revenus et baisse d'activité résultant directement de la mise en œuvre de la SfN"
    },
    {
      "id": 3,
      "name": "Impacts négatifs générés par des travaux",
      "description": "Impacts (externalités) environnementaux temporaires générés par les travaux nécessaires à la mise en œuvre de la SfN"
    },
    {
      "id": 4,
      "name": "Impacts négatifs environnementaux",
      "description": "Impacts négatifs potentiels de la SfN sur les services écosystémiques, résultant des modifications des milieux, des usages ou des modes de gestion induites par sa mise en œuvre"
    },
    {
      "id": 5,
      "name": "Contribution aux retombées économiques pour le territoire",
      "description": "Soutien à l'activité économique du territoire, y compris SfN de taille via des impacts indirects (p.e. filières d’intrants ou de produits) ou induits (p.e. via l’achat de biens et services par les salariés des entreprises impliquées dans les travaux de restauration)"
    },
    {
      "id": 6,
      "name": "Régulation des crues et inondations",
      "description": "Impacts résultant de l’atténuation des risques naturels crues et inondations"
    },
    {
      "id": 7,
      "name": "Atténuation des épisodes de sécheresse",
      "description": "Impacts résultant de l’atténuation de l'intensité et de la fréquence des épisodes de sécheresse"
    },
    {
      "id": 8,
      "name": "Atténuation des hausses de températures",
      "description": "Impacts résultant de l’atténuation des épisodes de fortes chaleurs et de canicules, notamment à l’échelle locale, contribuant à la diminution du stress thermique pour les systèmes humains et naturels"
    },
    {
      "id": 9,
      "name": "Amélioration de la qualité de l’eau",
      "description": "Impacts résultant de l’amélioration de la qualité des eaux (p.e. réduction des polluants/nutriments/sédiments), contribuant au bon fonctionnement des écosystèmes aquatiques et aux usages de l’eau."
    },
    {
      "id": 10,
      "name": "Stockage du carbone",
      "description": "Séquestration du carbone et atténuation des gaz à effet de serre"
    },
    {
      "id": 11,
      "name": "Impact sur les productions primaires",
      "description": "Productions agricoles, forestières et piscicoles (sécurisation, productions nouvelles…)"
    },
    {
      "id": 12,
      "name": "Activités récréatives et culturelles",
      "description": "Développement d'activités récréatives, culturelles et éducatives (p.e. activités touristiques)"
    },
    {
      "id": 13,
      "name": "Amélioration du cadre de vie",
      "description": "Amélioration de la qualité du paysage et des espaces de vie, impacts sur la santé et le bien-être des habitants"
    },
    {
      "id": 14,
      "name": "Amélioration du patrimoine naturel (biodiversité)",
      "description": "Amélioration de la qualité des sites, espaces et espèces naturels protégés, amélioration de la biodiversité des territoires"
    }
  ],
